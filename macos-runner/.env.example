# Copy to `.env` (gitignored) and fill. The PAT mints a short-lived registration token at
# setup time only — it is never written into the runner config.
GH_OWNER=tommyroar
GH_REPO=tommybot                       # the repo whose MLX/deploy gates this runner serves
RUNNER_PAT=github_pat_xxxxx            # fine-grained PAT · Administration: read+write on GH_REPO
RUNNER_LABELS=self-hosted,macos,arm64,metal,mini
# RUNNER_VERSION=2.321.0
# RUNNER_DIR=~/actions-runner-mini
