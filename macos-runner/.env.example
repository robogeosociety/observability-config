# Copy to `.env` (gitignored) and fill. The PAT mints a short-lived registration token at
# setup time only — it is never written into the runner config.
#
# Pick ONE scope:
#
# ── ORG mode (preferred once tommyroar is an org) — one runner serves every repo ──
# GH_ORG=tommyroar-org                 # the org; PAT needs org-level Administration/manage_runners
#
# ── REPO mode (user account — one repo only) ──
GH_OWNER=tommyroar
GH_REPO=tommybot                       # the repo whose MLX/deploy gates this runner serves

RUNNER_PAT=github_pat_xxxxx            # fine-grained PAT · Administration: read+write (org or repo, matching the mode)
RUNNER_LABELS=self-hosted,macos,arm64,metal,mini
# RUNNER_VERSION=2.321.0
# RUNNER_DIR=~/actions-runner-mini
