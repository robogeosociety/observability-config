# Never commit secrets, data, logs, or deps.
**/.env
**/.env.*
!**/.env.example

# python test artifacts
__pycache__/
.pytest_cache/

# grafana
grafana/playwright/node_modules/
grafana/playwright/test-results/
grafana/playwright/playwright-report/
grafana/playwright/*.png

# influxdb (data snapshots + runtime log — regenerated, not config)
influxdb/backups/
influxdb/bridge.log
# Live InfluxDB data + config now bind-mounted here from the container (its data
# was moved onto the 2TB /Volumes/dev disk). Runtime state — never commit.
influxdb/data/
influxdb/config/

# logs anywhere
**/*.log

# wrangler local cache (created when r2_upload.py / backup.sh shell out to wrangler)
**/.wrangler/
