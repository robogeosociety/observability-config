# ask-dash secrets — copy to .env (gitignored, chmod 600) and fill in.
# Host tools (MCP server, CLI) use the localhost URLs below; the Discord-bot
# container overrides INFLUX_URL/GRAFANA_URL with container-network names.

# InfluxDB — a READ-ONLY token scoped to all buckets (no write/delete). Mint with:
#   influx auth create --org home --token <admin> --read-bucket <id> [...] \
#     --description "ask-dash read-only (all buckets)"
INFLUX_URL=http://localhost:8086
INFLUX_ORG=home
INFLUX_READ_TOKEN=

# Grafana — a Viewer service-account token (reuse the existing GRAFANA_SA_TOKEN).
GRAFANA_URL=http://localhost:3001
GRAFANA_TOKEN=

# Anthropic — used by the Discord bot + CLI summary loop (NOT the MCP path).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Discord gateway bot. Create an application + bot at https://discord.com/developers,
# copy the Bot token. DISCORD_GUILD_ID = your server id (instant /ask sync).
# DISCORD_ALLOWED_USER_IDS = comma-separated user ids allowed to run /ask.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ALLOWED_USER_IDS=

# Guard rails.
QUERY_TIMEOUT_S=20
MAX_ROWS=500
