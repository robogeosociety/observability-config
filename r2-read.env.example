# Shared R2 read credentials — copy to ~/.observability/r2-read.env (chmod 600).
#
# ONE R2 API token, "Object Read", applied to ALL buckets in the account. Every
# ingest in this stack (campsites today, any bucket you add later) sources these
# same creds: add a bucket → point its ingest here → no new token. Rotate by
# editing this one file. R2 API tokens don't expire, so there's no OAuth refresh
# to break an unattended job.
#
# Create at: Cloudflare dashboard → R2 → Manage R2 API Tokens → Create API Token
#   Permission: Object Read · Buckets: Apply to all buckets · TTL: forever
#
# Consumed automatically by any ingest that calls campsites/ingest.py-style
# loading (R2_READ_ENV overrides the path). Account id is not secret (it's in the
# public R2 endpoint); the access key + secret are.
R2_ACCOUNT_ID=d7adee58513c1b2f770ccaac90cf114f
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
