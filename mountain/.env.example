# mountain ingest secrets — copy to mountain/.env (gitignored, chmod 600).

# InfluxDB (write to the `mountain` bucket)
INFLUX_URL=http://localhost:8086
INFLUX_ORG=home
INFLUX_MOUNTAIN_BUCKET=mountain
# Write-only token scoped to `mountain` (influx auth create --write-bucket ...).
# Falls back to INFLUX_ADMIN_TOKEN if unset.
INFLUX_MOUNTAIN_TOKEN=

# Public history.jsonl the inference Worker writes (is-the-mountain-out-public R2).
MOUNTAIN_HISTORY_URL=https://pub-66d3d1f139004e29b2afcb5fba49bdb3.r2.dev/history.jsonl
