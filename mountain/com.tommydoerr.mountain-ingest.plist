<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tommydoerr.mountain-ingest</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Volumes/dev/observability/mountain/ingest.sh</string>
    </array>
    <!-- Every 15 min, matching the inference Worker's */15 cron. Idempotent
         (InfluxDB overwrites same-timestamp points), so exact alignment is fine. -->
    <key>StartInterval</key>
    <integer>900</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/tommydoerr/Library/Logs/mountain-ingest.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/tommydoerr/Library/Logs/mountain-ingest.log</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
