# discord-mini-mem secrets — copy to .env (gitignored, chmod 600).
# The bot token is the same one the OpsBot Discord channel uses; the live message
# must be authored by that bot so the container can edit it.
DISCORD_BOT_TOKEN=        # OpsBot bot token (from ~/.claude/channels/discord-ops/.env)
DISCORD_CHANNEL_ID=1520850187105341710
INTERVAL=60
