<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd job for the Claude Code usage collector. deploy.sh copies this verbatim
  to ~/Library/LaunchAgents/. The InfluxDB write token is NOT here — deploy.sh
  writes it to ~/.local/share/claude-usage-collector/.env (chmod 600) and the
  collector reads it itself, so the secret never lands in this plist (or in
  `launchctl print` env dumps / plist backups). Only non-secret config lives below.

  collector.py is pure stdlib, so /usr/bin/python3 needs no venv/uv.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tommy.claude-usage</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/tommydoerr/.local/share/claude-usage-collector/collector.py</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>INFLUX_URL</key>
        <string>http://localhost:8086</string>
        <key>INFLUX_ORG</key>
        <string>home</string>
        <key>INFLUX_CLAUDE_USAGE_BUCKET</key>
        <string>claude_code</string>
    </dict>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/tommydoerr/Library/Logs/claude-usage-collector.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/tommydoerr/Library/Logs/claude-usage-collector.log</string>
</dict>
</plist>
