# walksheds-uptime collector config. Copy to .env (chmod 600); never commit .env.
INFLUX_URL=http://localhost:8086
INFLUX_ORG=home
INFLUX_BUCKET=ops
INFLUX_TOKEN=        # ops-bucket write token (see influxdb/.env INFLUX_OPS_TOKEN)
GH_REPO=robogeosociety/walksheds
GH_TOKEN=            # GitHub token (public-repo read; avoids API rate limits)
