{
  "annotations": {
    "list": [
      {
        "name": "Deploys",
        "datasource": { "type": "influxdb", "uid": "ops" },
        "enable": true,
        "iconColor": "blue",
        "target": {
          "query": "from(bucket: \"ops\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"deploy\" and r.service == \"walksheds\" and r.state == \"success\" and r._field == \"ok\")\n  |> keep(columns: [\"_time\", \"state\"])"
        }
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "liveNow": false,
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["walksheds", "uptime"],
  "templating": { "list": [] },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Walksheds Uptime",
  "uid": "walksheds-uptime",
  "version": 1,
  "weekStart": "",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Status",
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "ops" },
      "targets": [{
        "datasource": { "type": "influxdb", "uid": "ops" },
        "refId": "A",
        "query": "from(bucket: \"ops\")\n  |> range(start: -15m)\n  |> filter(fn: (r) => r._measurement == \"uptime\" and r.service == \"walksheds\" and r._field == \"up\")\n  |> last()\n  |> keep(columns: [\"_value\"])"
      }],
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "UP", "color": "green", "index": 0 } } },
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 1 } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Uptime (range)",
      "gridPos": { "h": 4, "w": 5, "x": 5, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "ops" },
      "targets": [{
        "datasource": { "type": "influxdb", "uid": "ops" },
        "refId": "A",
        "query": "from(bucket: \"ops\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"uptime\" and r.service == \"walksheds\" and r._field == \"up\")\n  |> mean()\n  |> map(fn: (r) => ({ r with _value: r._value * 100.0 }))"
      }],
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 99 }, { "color": "green", "value": 99.9 } ] }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Latency (now)",
      "gridPos": { "h": 4, "w": 4, "x": 10, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "ops" },
      "targets": [{
        "datasource": { "type": "influxdb", "uid": "ops" },
        "refId": "A",
        "query": "from(bucket: \"ops\")\n  |> range(start: -15m)\n  |> filter(fn: (r) => r._measurement == \"uptime\" and r.service == \"walksheds\" and r._field == \"latency_ms\")\n  |> last()\n  |> keep(columns: [\"_value\"])"
      }],
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1000 }, { "color": "red", "value": 3000 } ] }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Last CI smoke",
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "ops" },
      "targets": [{
        "datasource": { "type": "influxdb", "uid": "ops" },
        "refId": "A",
        "query": "from(bucket: \"ops\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r._measurement == \"ci_smoke\" and r.service == \"walksheds\" and r._field == \"ok\")\n  |> last()\n  |> keep(columns: [\"_value\"])"
      }],
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "PASS", "color": "green", "index": 0 } } },
            { "type": "value", "options": { "0": { "text": "FAIL", "color": "red", "index": 1 } } }
          ],
          "noValue": "no runs yet",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Deploys (24h)",
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "ops" },
      "targets": [{
        "datasource": { "type": "influxdb", "uid": "ops" },
        "refId": "A",
        "query": "from(bucket: \"ops\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r._measurement == \"deploy\" and r.service == \"walksheds\" and r.state == \"success\" and r._field == \"ok\")\n  |> count()"
      }],
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "text", "value": null } ] } }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Response latency",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 4 },
      "datasource": { "type": "influxdb", "uid": "ops" },
      "targets": [{
        "datasource": { "type": "influxdb", "uid": "ops" },
        "refId": "A",
        "query": "from(bucket: \"ops\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"uptime\" and r.service == \"walksheds\" and r._field == \"latency_ms\")\n  |> keep(columns: [\"_time\", \"_value\"])"
      }],
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never", "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "showLegend": false }, "tooltip": { "mode": "single" } }
    },
    {
      "id": 7,
      "type": "state-timeline",
      "title": "Up / down",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 4 },
      "datasource": { "type": "influxdb", "uid": "ops" },
      "targets": [{
        "datasource": { "type": "influxdb", "uid": "ops" },
        "refId": "A",
        "query": "from(bucket: \"ops\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"uptime\" and r.service == \"walksheds\" and r._field == \"up\")\n  |> keep(columns: [\"_time\", \"_value\"])"
      }],
      "options": { "showValue": "never", "mergeValues": true, "rowHeight": 0.9, "legend": { "showLegend": false } },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "up", "color": "green", "index": 0 } } },
            { "type": "value", "options": { "0": { "text": "down", "color": "red", "index": 1 } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Recent deploys",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "influxdb", "uid": "ops" },
      "targets": [{
        "datasource": { "type": "influxdb", "uid": "ops" },
        "refId": "A",
        "query": "from(bucket: \"ops\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"deploy\" and r.service == \"walksheds\" and r._field == \"ok\")\n  |> keep(columns: [\"_time\", \"state\", \"environment\"])\n  |> sort(columns: [\"_time\"], desc: true)"
      }],
      "options": { "showHeader": true },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    }
  ]
}
