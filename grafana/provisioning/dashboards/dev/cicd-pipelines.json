      "uid": "cicd"
     },
     "query": "from(bucket: \"cicd\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"workflow_inventory\" and r._field == \"present\")\n  |> filter(fn: (r) => r.repo =~ /^(${repo:regex})$/ and r.workflow =~ /^(${workflow:regex})$/)\n  |> group(columns: [\"repo\", \"workflow\"])\n  |> sort(columns: [\"_time\"])\n  |> tail(n: 1)\n  |> group()\n  |> keep(columns: [\"repo\", \"workflow\", \"state\", \"path\"])\n  |> sort(columns: [\"repo\", \"workflow\"])"
