  {
   "id": 9,
   "type": "table",
   "title": "Latest run per pipeline",
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 14,
    "h": 9
   },
   "datasource": {
    "type": "influxdb",
    "uid": "cicd"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "cicd"
     },
     "query": "from(bucket: \"cicd\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"workflow_run\" and (r._field == \"duration_s\" or r._field == \"run_id\"))\n  |> filter(fn: (r) => r.repo =~ /^(${repo:regex})$/ and r.workflow =~ /^(${workflow:regex})$/)\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group(columns: [\"repo\", \"workflow\"])\n  |> sort(columns: [\"_time\"])\n  |> tail(n: 1)\n  |> map(fn: (r) => ({ r with url: \"https://github.com/\" + r.org + \"/\" + r.repo + \"/actions/runs/\" + string(v: int(v: r.run_id)) }))\n  |> group()\n  |> keep(columns: [\"_time\", \"repo\", \"workflow\", \"branch\", \"event\", \"conclusion\", \"duration_s\", \"url\"])\n  |> sort(columns: [\"_time\"], desc: true)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "filterable": true
     }
