              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "barchart",
      "title": "Anomalies by metric",
      "description": "Count of anomaly events per metric in the window.",
      "gridPos": {
        "x": 14,
        "y": 5,
        "w": 10,
        "h": 5
      },
      "datasource": {
        "type": "influxdb",
        "uid": "ops"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "ops"
          },
          "format": "table",
          "query": "from(bucket: \"ops\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"anomaly\" and r._field == \"zscore\")\n  |> group(columns: [\"metric\"])\n  |> count()\n  |> group()\n  |> keep(columns: [\"metric\", \"_value\"])\n  |> rename(columns: {_value: \"events\"})\n  |> sort(columns: [\"events\"], desc: true)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "metric",
        "showValue": "auto",
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 101,
      "type": "row",
      "title": "Anomalies \u2014 window z-score (ops.anomaly)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Anomaly z-scores over time",
      "description": "Each point is a recorded anomaly (|z| >= z_warn), per metric. Above +3 / below -3 are the warn bands; \u00b14 crit. Sparse by design \u2014 points, not lines.",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "influxdb",
        "uid": "ops"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "ops"
          },
          "query": "from(bucket: \"ops\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"anomaly\" and r._field == \"zscore\")\n  |> group(columns: [\"metric\"])\n  |> keep(columns: [\"_time\", \"_value\", \"metric\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "points",
            "pointSize": 7,
            "showPoints": "always",
            "lineWidth": 0,
            "axisCenteredZero": true,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": -4
              },
              {
                "color": "green",
                "value": -3
              },
              {
                "color": "green",
                "value": 3
              },
              {
                "color": "red",
                "value": 4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "count"
          ]
        }
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Recent anomalies",
      "description": "Latest anomaly events with z, observed value, and the window baseline (mean \u00b1 stddev) it deviated from.",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "influxdb",
        "uid": "ops"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "ops"
          },
          "format": "table",
          "query": "from(bucket: \"ops\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"anomaly\")\n  |> pivot(rowKey: [\"_time\", \"metric\", \"bucket\", \"severity\", \"direction\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> keep(columns: [\"_time\", \"metric\", \"severity\", \"direction\", \"zscore\", \"value\", \"mean\", \"stddev\"])\n  |> group()\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 100)"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "_time": 0,
              "metric": 1,
              "severity": 2,
              "direction": 3,
              "zscore": 4,
              "value": 5,
              "mean": 6,
              "stddev": 7
            },
            "renameByName": {
              "_time": "Time",
              "metric": "Metric",
              "severity": "Severity",
              "direction": "Dir",
              "zscore": "z",
              "value": "Value",
              "mean": "Baseline mean",
              "stddev": "Baseline \u03c3"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Severity"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "crit": {
                        "color": "red",
                        "index": 0
                      },
                      "warn": {
                        "color": "orange",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "z"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Time",
            "desc": true
          }
        ],
        "cellHeight": "sm"
      }
    }
  ],
