    {
      "id": 9,
      "type": "table",
      "title": "Recent backups",
      "gridPos": {"x": 0, "y": 27, "w": 24, "h": 10},
      "datasource": {"type": "influxdb", "uid": "ops"},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "influxdb", "uid": "ops"},
        "query": "from(bucket: \"ops\")\n  |> range(start: -90d)\n  |> filter(fn: (r) => r._measurement == \"backup\")\n  |> pivot(rowKey: [\"_time\", \"target\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> keep(columns: [\"_time\", \"target\", \"success\", \"bytes\", \"duration_s\"])\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 30)"
      }],
      "transformations": [],
      "fieldConfig": {
        "defaults": {"custom": {"align": "auto", "filterable": true}},
        "overrides": [
          {"matcher": {"id": "byName", "options": "_time"}, "properties": [{"id": "displayName", "value": "Time"}, {"id": "custom.width", "value": 200}]},
          {"matcher": {"id": "byName", "options": "target"}, "properties": [{"id": "displayName", "value": "Target"}, {"id": "custom.width", "value": 100}]},
          {"matcher": {"id": "byName", "options": "bytes"}, "properties": [{"id": "displayName", "value": "Size"}, {"id": "unit", "value": "decbytes"}]},
          {"matcher": {"id": "byName", "options": "duration_s"}, "properties": [{"id": "displayName", "value": "Duration"}, {"id": "unit", "value": "s"}, {"id": "custom.width", "value": 110}]},
          {"matcher": {"id": "byName", "options": "success"},
           "properties": [
             {"id": "displayName", "value": "Result"}, {"id": "custom.width", "value": 100},
             {"id": "mappings", "value": [{"type": "value", "options": {"1": {"text": "OK", "color": "green", "index": 0}, "0": {"text": "FAIL", "color": "red", "index": 1}}}]},
             {"id": "custom.cellOptions", "value": {"type": "color-background", "mode": "basic"}},
             {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}},
             {"id": "color", "value": {"mode": "thresholds"}}
           ]}
        ]
