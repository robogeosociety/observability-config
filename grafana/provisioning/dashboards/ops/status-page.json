        "query": "from(bucket: \"transit_tracker\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"service_gauge\")\n  |> keep(columns: [\"_time\"])\n  |> max(column: \"_time\")\n  |> group()\n  |> max(column: \"_time\")\n  |> map(fn: (r) => ({ _value: float(v: int(v: now()) - int(v: r._time)) / 1000000000.0 }))\n  |> keep(columns: [\"_value\"])"
      }],
