{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "liveNow": false,
  "refresh": "5m",
  "schemaVersion": 39,
  "tags": ["obsidian", "backups"],
  "templating": { "list": [] },
  "time": { "from": "now-30d", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Obsidian Backups — per vault",
  "uid": "obsidian-backups",
  "version": 1,
  "weekStart": "",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Last backup age — per vault",
      "description": "Time since each vault's last successful backup (ops/backup, target=obsidian). Green < 36h, red > 48h (backup runs ~daily). One tile per live vault, keyed by the fan-out backup's `vault` tag (camping/gear/dev/home).",
      "datasource": { "type": "influxdb", "uid": "ops" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "displayName": "${__field.labels.vault}",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 129600 },
              { "color": "red", "value": 172800 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "ops" },
          "query": "from(bucket: \"ops\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"backup\" and r.target == \"obsidian\" and r._field == \"success\" and r._value == 1)\n  |> filter(fn: (r) => exists r.vault)\n  |> group(columns: [\"vault\"])\n  |> last()\n  |> map(fn: (r) => ({ r with _value: float(v: int(v: now()) - int(v: r._time)) / 1000000000.0 }))\n  |> keep(columns: [\"vault\", \"_value\"])"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Vault size",
      "description": "Backup size (bytes) per vault over time — a sudden drop flags silent truncation, steady climb flags runaway growth.",
      "datasource": { "type": "influxdb", "uid": "ops" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "displayName": "${__field.labels.vault}",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": true,
            "axisCenteredZero": false,
            "gradientMode": "none"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["last"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "ops" },
          "query": "from(bucket: \"ops\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"backup\" and r.target == \"obsidian\" and r._field == \"bytes\")\n  |> filter(fn: (r) => exists r.vault)\n  |> keep(columns: [\"_time\", \"_value\", \"vault\"])\n  |> group(columns: [\"vault\"])\n  |> aggregateWindow(every: 1h, fn: last, createEmpty: false)"
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Last run — per vault",
      "description": "Most recent backup per vault: result, size, and duration (ops/backup, target=obsidian).",
      "datasource": { "type": "influxdb", "uid": "ops" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "success" },
            "properties": [
              { "id": "displayName", "value": "Result" },
              { "id": "mappings", "value": [
                { "type": "value", "options": { "0": { "text": "FAIL", "color": "red", "index": 0 } } },
                { "type": "value", "options": { "1": { "text": "OK", "color": "green", "index": 1 } } }
              ] },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "bytes" },
            "properties": [
              { "id": "displayName", "value": "Size" },
              { "id": "unit", "value": "bytes" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "duration_s" },
            "properties": [
              { "id": "displayName", "value": "Duration" },
              { "id": "unit", "value": "s" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "vault" },
            "properties": [ { "id": "displayName", "value": "Vault" } ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Vault", "desc": false }]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "ops" },
          "query": "from(bucket: \"ops\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"backup\" and r.target == \"obsidian\" and (r._field == \"success\" or r._field == \"bytes\" or r._field == \"duration_s\"))\n  |> filter(fn: (r) => exists r.vault)\n  |> group(columns: [\"vault\", \"_field\"])\n  |> last()\n  |> keep(columns: [\"vault\", \"_field\", \"_value\"])\n  |> group()\n  |> pivot(rowKey: [\"vault\"], columnKey: [\"_field\"], valueColumn: \"_value\")"
        }
      ]
    }
  ]
}
