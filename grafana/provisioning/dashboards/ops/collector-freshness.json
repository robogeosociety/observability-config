        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "### Collector Freshness\nWrite rate for each continuously-fed bucket. A line dropping to **0 (or *No data*) for 15m** trips the matching `Collector stalled` alert \u2014 and that panel is screenshotted into the Discord alert (the *offending graph*). Green = writing, red = stalled."
      }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "transit_tracker \u2014 write rate",
      "description": "Points written to the `transit_tracker` bucket per scrape interval (scales with the time range). Flat/empty = the collector stalled \u2014 this is the panel the `Collector stalled \u2014 transit_tracker` alert screenshots into Discord.",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "influxdb",
        "uid": "transit_tracker"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "transit_tracker"
          },
          "query": "from(bucket: \"transit_tracker\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> aggregateWindow(every: v.windowPeriod, fn: count, createEmpty: false)\n  |> group(columns: [\"_time\"])\n  |> sum()\n  |> group()\n  |> sort(columns: [\"_time\"])\n  |> set(key: \"_field\", value: \"points\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 18,
            "showPoints": "never",
            "spanNulls": false,
            "gradientMode": "opacity"
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "min"
          ]
        }
      }
    },
