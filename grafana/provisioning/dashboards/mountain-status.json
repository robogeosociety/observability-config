          "query": "from(bucket: \"mountain\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r._measurement == \"prediction\" and r._field == \"class_index\")\n  |> last()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Not Out", "color": "red", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "Full", "color": "green", "index": 1 } } },
            { "type": "value", "options": { "2": { "text": "Partial", "color": "yellow", "index": 2 } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Visible confidence (full + partial)",
      "datasource": { "type": "influxdb", "uid": "mountain" },
      "gridPos": { "x": 16, "y": 1, "w": 8, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "mountain" },
          "query": "from(bucket: \"mountain\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r._measurement == \"prediction\" and r._field == \"conf_not_out\")\n  |> last()\n  |> map(fn: (r) => ({ r with _value: 1.0 - r._value }))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "green", "value": 0.75 } ] }
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 101,
      "type": "row",
      "title": "History",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Class confidence over time",
      "datasource": { "type": "influxdb", "uid": "mountain" },
      "gridPos": { "x": 0, "y": 7, "w": 24, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "mountain" },
          "query": "from(bucket: \"mountain\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"prediction\" and (r._field == \"conf_not_out\" or r._field == \"conf_full\" or r._field == \"conf_partial\"))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 25,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "mode": "normal", "group": "A" }
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          { "matcher": { "id": "byFrameRefID", "options": "A" }, "properties": [] }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["last", "mean", "max"] }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Mountain out (1) / not out (0)",
      "datasource": { "type": "influxdb", "uid": "mountain" },
      "gridPos": { "x": 0, "y": 15, "w": 12, "h": 7 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "mountain" },
          "query": "from(bucket: \"mountain\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"prediction\" and r._field == \"is_out\")\n  |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 30,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": { "mode": "area" }
          },
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "showLegend": false, "displayMode": "list", "placement": "bottom", "calcs": [] }
      }
    },
    {
      "id": 12,
      "type": "piechart",
      "title": "Class distribution (selected range)",
      "datasource": { "type": "influxdb", "uid": "mountain" },
      "gridPos": { "x": 12, "y": 15, "w": 12, "h": 7 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "mountain" },
          "query": "from(bucket: \"mountain\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"prediction\" and r._field == \"class_index\")\n  |> group(columns: [\"class_name\"])\n  |> count()\n  |> group()"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "hideFrom": { "tooltip": false, "viz": false, "legend": false } } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "pieType": "donut",
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "showLegend": true, "displayMode": "table", "placement": "right", "values": ["value", "percent"] }
      }
    },
    {
      "id": 102,
      "type": "row",
      "title": "Weather (METAR — KSEA)",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 22, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Visibility (sm) & ceiling (ft)",
      "datasource": { "type": "influxdb", "uid": "mountain" },
      "gridPos": { "x": 0, "y": 23, "w": 24, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "mountain" },
          "query": "from(bucket: \"mountain\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"prediction\" and (r._field == \"visibility_sm\" or r._field == \"ceiling_ft\"))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": true,
            "axisPlacement": "left"
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*ceiling_ft.*" },
            "properties": [
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "unit", "value": "lengthft" }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".*visibility_sm.*" },
            "properties": [
              { "id": "unit", "value": "mi" }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["last", "min", "max"] }
      }
    }
