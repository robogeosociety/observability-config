    {
      "id": 1,
      "type": "stat",
      "title": "Is the mountain out?",
      "datasource": { "type": "influxdb", "uid": "mountain" },
      "gridPos": { "x": 0, "y": 1, "w": 8, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "mountain" },
          "query": "from(bucket: \"mountain\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r._measurement == \"prediction\" and r._field == \"is_out\")\n  |> last()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "NOT OUT", "color": "red", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "OUT", "color": "green", "index": 1 } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Current class",
      "datasource": { "type": "influxdb", "uid": "mountain" },
