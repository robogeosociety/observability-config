    {
      "id": 20,
      "type": "table",
      "title": "Recent errors",
      "datasource": { "type": "influxdb", "uid": "mountain" },
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 9 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "mountain" },
          "query": "from(bucket: \"mountain\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"tick\" and r._field == \"ok\" and r.status == \"error\")\n  |> keep(columns: [\"_time\", \"error_type\"])\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 100)"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "filterable": true } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "_time" }, "properties": [ { "id": "custom.width", "value": 220 }, { "id": "displayName", "value": "Time" } ] },
          { "matcher": { "id": "byName", "options": "error_type" }, "properties": [ { "id": "displayName", "value": "Error type" } ] }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [ { "displayName": "Time", "desc": true } ]
      }
    }
  ],
