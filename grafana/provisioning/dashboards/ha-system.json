    {
      "id": 20,
      "type": "table",
      "title": "Volumes",
      "datasource": {
        "type": "influxdb",
        "uid": "system"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "system"
          },
          "query": "from(bucket: \"system\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"disk\" and (r._field == \"used_percent\" or r._field == \"used\" or r._field == \"free\" or r._field == \"total\"))\n  |> filter(fn: (r) => r.host =~ /${host:regex}/)\n  |> filter(fn: (r) => r.path =~ /^(${mount:regex})$/)\n  |> last()\n  |> pivot(rowKey: [\"path\", \"device\", \"fstype\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> keep(columns: [\"path\", \"device\", \"used\", \"free\", \"total\", \"used_percent\"])\n  |> group()\n  |> sort(columns: [\"used_percent\"], desc: true)"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "path": 0,
              "device": 1,
              "used_percent": 2,
              "used": 3,
              "free": 4,
              "total": 5
            },
            "renameByName": {
              "path": "Mount",
              "device": "Device",
              "used_percent": "Used %",
              "used": "Used",
              "free": "Free",
              "total": "Total"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Used %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
