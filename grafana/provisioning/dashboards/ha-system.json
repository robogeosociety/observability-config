        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "system"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"system\", tag: \"host\")",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "homeassistant"
          ],
          "value": [
            "homeassistant"
          ]
        }
      },
      {
        "name": "mount",
        "label": "Mount",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "system"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"system\", tag: \"path\", predicate: (r) => r._measurement == \"disk\" and (r.path == \"/\" or r.path == \"/System/Volumes/Data\" or r.path =~ /^\\/Volumes\\// or r.path =~ /^\\/Users\\//))",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "iface",
        "label": "Interface",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "system"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"system\", tag: \"interface\", predicate: (r) => r._measurement == \"net\" and r.interface =~ /^en[0-9]+$/)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
