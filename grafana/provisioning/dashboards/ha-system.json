      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "system"
          },
          "query": "from(bucket: \"system\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"cpu\" and r.cpu == \"cpu-total\" and r._field == \"usage_active\")\n  |> filter(fn: (r) => r.host =~ /${host:regex}/)\n  |> last()"
