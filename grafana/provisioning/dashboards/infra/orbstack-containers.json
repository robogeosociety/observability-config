      "title": "Running containers",
      "description": "Containers currently running, per the OrbStack Docker engine.",
      "datasource": { "type": "influxdb", "uid": "system" },
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 5 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "system" },
          "query": "from(bucket: \"system\")\n  |> range(start: -15m)\n  |> filter(fn: (r) => r._measurement == \"docker\" and r._field == \"n_containers_running\")\n  |> last()"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } },
