      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["last", "mean", "max"] }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Memory % of limit per container",
      "description": "Container memory as a percent of its mem_limit (2048 MiB cap). Yellow ≥80%, red ≥95% — sustained red means it will soon be OOM-killed by Docker (the intended blast-radius cap, not a VM-wide thrash).",
      "datasource": { "type": "influxdb", "uid": "system" },
      "gridPos": { "x": 0, "y": 15, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "system" },
          "query": "from(bucket: \"system\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"docker_container_mem\" and r._field == \"usage_percent\")\n  |> group(columns: [\"container_name\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"container_name\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": true,
            "thresholdsStyle": { "mode": "dashed" }
          },
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 80 }, { "color": "red", "value": 95 } ] }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["last", "max"] }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Network I/O per container",
      "description": "Per-container network throughput (rate of rx/tx bytes, total across interfaces).",
      "datasource": { "type": "influxdb", "uid": "system" },
      "gridPos": { "x": 12, "y": 15, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "system" },
          "query": "from(bucket: \"system\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"docker_container_net\" and (r._field == \"rx_bytes\" or r._field == \"tx_bytes\"))\n  |> filter(fn: (r) => r.network == \"total\")\n  |> group(columns: [\"container_name\", \"_field\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n  |> derivative(unit: 1s, nonNegative: true)\n  |> keep(columns: [\"_time\", \"_value\", \"container_name\", \"_field\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] }
      }
    },
    {
      "id": 102,
      "type": "row",
      "title": "Disk I/O & health",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 23, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Block I/O per container",
      "description": "Per-container disk read/write throughput (rate of blkio bytes, total device). Heavy sustained I/O here is the class of activity that hung the VM on 2026-05-31.",
      "datasource": { "type": "influxdb", "uid": "system" },
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 7 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "system" },
          "query": "from(bucket: \"system\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"docker_container_blkio\" and (r._field == \"io_service_bytes_recursive_read\" or r._field == \"io_service_bytes_recursive_write\"))\n  |> filter(fn: (r) => r.device == \"total\")\n  |> group(columns: [\"container_name\", \"_field\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n  |> derivative(unit: 1s, nonNegative: true)\n  |> keep(columns: [\"_time\", \"_value\", \"container_name\", \"_field\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] }
      }
    },
    {
      "id": 20,
      "type": "table",
      "title": "Container status",
      "description": "Latest state per container: status, restart count, last exit code, OOM-killed flag, and uptime. Non-zero restart counts / exit codes flag the kind of crash loop seen with transit-tracker.",
      "datasource": { "type": "influxdb", "uid": "system" },
      "gridPos": { "x": 0, "y": 31, "w": 24, "h": 9 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "system" },
          "query": "from(bucket: \"system\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"docker_container_status\")\n  |> filter(fn: (r) => r._field == \"restart_count\" or r._field == \"exitcode\" or r._field == \"oomkilled\" or r._field == \"uptime_ns\")\n  |> last()\n  |> pivot(rowKey: [\"container_name\", \"container_status\", \"container_image\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> keep(columns: [\"container_name\", \"container_status\", \"container_image\", \"restart_count\", \"exitcode\", \"oomkilled\", \"uptime_ns\"])\n  |> sort(columns: [\"container_name\"])"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "indexByName": { "container_name": 0, "container_status": 1, "uptime_ns": 2, "restart_count": 3, "exitcode": 4, "oomkilled": 5, "container_image": 6 } } }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "filterable": true } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "container_name" }, "properties": [ { "id": "displayName", "value": "Container" }, { "id": "custom.width", "value": 200 } ] },
          { "matcher": { "id": "byName", "options": "container_status" }, "properties": [ { "id": "displayName", "value": "Status" } ] },
          { "matcher": { "id": "byName", "options": "uptime_ns" }, "properties": [ { "id": "displayName", "value": "Uptime" }, { "id": "unit", "value": "ns" } ] },
          { "matcher": { "id": "byName", "options": "restart_count" }, "properties": [ { "id": "displayName", "value": "Restarts" }, { "id": "custom.cellOptions", "value": { "type": "color-text" } }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } ] },
          { "matcher": { "id": "byName", "options": "exitcode" }, "properties": [ { "id": "displayName", "value": "Last exit" } ] },
          { "matcher": { "id": "byName", "options": "oomkilled" }, "properties": [ { "id": "displayName", "value": "OOM-killed" } ] },
          { "matcher": { "id": "byName", "options": "container_image" }, "properties": [ { "id": "displayName", "value": "Image" } ] }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [ { "displayName": "Restarts", "desc": true } ]
      }
    }
  ],
