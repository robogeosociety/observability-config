    {
      "id": 101,
      "type": "row",
      "title": "CPU & memory (per container)",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "CPU usage % per container",
      "description": "docker stats-style CPU percent (relative to total VM CPU; can exceed 100% across cores). Each container is capped at 2 vCPU (50% of the 4-core VM).",
      "datasource": { "type": "influxdb", "uid": "system" },
      "gridPos": { "x": 0, "y": 7, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "system" },
          "query": "from(bucket: \"system\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"docker_container_cpu\" and r._field == \"usage_percent\")\n  |> group(columns: [\"container_name\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"container_name\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "auto",
            "spanNulls": true
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["last", "mean", "max"] }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Memory usage per container",
      "description": "Resident memory per container (docker_container_mem.usage).",
      "datasource": { "type": "influxdb", "uid": "system" },
      "gridPos": { "x": 12, "y": 7, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "system" },
          "query": "from(bucket: \"system\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"docker_container_mem\" and r._field == \"usage\")\n  |> group(columns: [\"container_name\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"container_name\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
