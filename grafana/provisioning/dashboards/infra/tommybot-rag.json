{
  "annotations": {
    "list": [
      {
        "name": "Queries",
        "datasource": { "type": "influxdb", "uid": "tommybot" },
        "enable": true,
        "iconColor": "#FF9830",
        "query": "from(bucket: \"tommybot\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"query\" and r._field == \"snippet\")\n  |> keep(columns: [\"_time\", \"_value\", \"source\"])",
        "textColumn": "_value",
        "tagsColumn": "source",
        "type": "tags"
      }
    ]
