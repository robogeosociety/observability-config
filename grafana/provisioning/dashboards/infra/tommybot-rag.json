    {
      "id": 7,
      "type": "table",
      "title": "Recent Queries",
      "description": "Last 20 queries with source routing, duration, and snippet.",
      "datasource": { "type": "influxdb", "uid": "tommybot" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 18 },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "_time" }, "properties": [ { "id": "displayName", "value": "Time" } ] },
          { "matcher": { "id": "byName", "options": "source" }, "properties": [ { "id": "displayName", "value": "Source" } ] },
          { "matcher": { "id": "byName", "options": "duration (s)" }, "properties": [ { "id": "unit", "value": "s" }, { "id": "decimals", "value": 1 } ] }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [ { "displayName": "Time", "desc": true } ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "influxdb", "uid": "tommybot" },
          "query": "import \"strings\"\n\nduration = from(bucket: \"tommybot\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"query\" and r._field == \"duration_s\")\n  |> keep(columns: [\"_time\", \"_value\", \"source\"])\n  |> rename(columns: {_value: \"duration (s)\"})\n\nsnippet = from(bucket: \"tommybot\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"query\" and r._field == \"snippet\")\n  |> keep(columns: [\"_time\", \"_value\"])\n  |> rename(columns: {_value: \"query\"})\n\njoin(tables: {d: duration, s: snippet}, on: [\"_time\"])\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 20)"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "_time_d": true, "_time_s": true },
            "renameByName": {}
          }
        }
      ]
    }
