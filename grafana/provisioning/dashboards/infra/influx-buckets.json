      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "ops"
          },
          "query": "from(bucket: \"ops\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"bucket_stats\" and r._field == \"disk_bytes\")\n  |> last()\n  |> group()\n  |> sum()\n  |> keep(columns: [\"_value\"])"
