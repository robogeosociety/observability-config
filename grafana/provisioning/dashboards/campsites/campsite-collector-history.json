          "query": "SELECT index1 AS site_id, argMax(blob4, timestamp) AS name, argMax(blob2, timestamp) AS agency, MAX(if(blob5='inactive', timestamp, toDateTime(0))) AS inactive_since FROM campsite_collector WHERE $timeFilter GROUP BY index1 HAVING inactive_since > MAX(if(blob5 IN ('ok','reactivated'), timestamp, toDateTime(0))) ORDER BY inactive_since DESC LIMIT 50",
