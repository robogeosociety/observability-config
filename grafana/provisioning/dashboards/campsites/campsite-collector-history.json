      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "campsites_ae"
          },
          "format": "table",
          "dateTimeColDataType": "timestamp",
          "dateTimeType": "DATETIME",
          "query": "SELECT count() AS inactive_now FROM (SELECT index1, MAX(if(blob5='inactive', timestamp, toDateTime(0))) AS inactive_at, MAX(if(blob5 IN ('ok','reactivated'), timestamp, toDateTime(0))) AS active_at FROM campsite_collector WHERE $timeFilter GROUP BY index1 HAVING inactive_at > active_at)"
        }
