    {
      "id": 31,
      "type": "timeseries",
      "title": "Failure ratio (% of attempts)",
      "description": "Failed collections as a share of all attempts. A healthy fleet sits near 0% (a single bad site backs off exponentially and is then quarantined). Sustained >25% means something is wrong system-wide, not with one site — this is what the 'collector failure ratio high' Discord alert watches.",
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
        "uid": "campsites_ae"
      },
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "campsites_ae"
          },
          "format": "time_series",
          "meta": {
            "timezone": "UTC"
          },
          "dateTimeColDataType": "timestamp",
          "dateTimeType": "DATETIME",
          "query": "SELECT $timeSeries AS t, 100 * SUMIf(_sample_interval, blob5='failed') / SUMIf(_sample_interval, blob5 IN ('ok','failed')) AS failure_pct FROM campsite_collector WHERE $timeFilter AND blob5 IN ('ok','failed') GROUP BY t ORDER BY t",
          "extrapolate": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 18,
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
