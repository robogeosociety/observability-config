    {
      "id": 32,
      "type": "stat",
      "title": "Inactive sites (now)",
      "description": "Sites currently quarantined in the DLQ — their most recent state change is 'inactive' with no later 'ok'/'reactivated'. Should be 0.",
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
