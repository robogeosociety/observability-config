    {
      "id": 5,
      "type": "state-timeline",
      "title": "Booking heatmap — campground × night (% booked)",
      "description": "Each row a campground, each cell a night, colour = % of its sites booked (green→red). Next 90 nights. Tip: pick one Agency to keep it readable.",
      "gridPos": {
