      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "campsites_ae"
          },
          "format": "time_series",
          "meta": {
            "timezone": "UTC"
          },
          "query": "SELECT toDateTime(night) AS t, name, IF(av + rs > 0, rs / (av + rs) * 100, 0.0) AS booked_pct FROM (SELECT index1, blob1 AS night, argMax(double1, timestamp) AS av, argMax(double2, timestamp) AS rs, argMax(blob2, timestamp) AS agency, argMax(blob3, timestamp) AS name FROM campsite_demand WHERE timestamp > now() - INTERVAL '48' HOUR GROUP BY index1, night) WHERE agency IN (${agency:singlequote}) AND name IN (${campsite:singlequote}) ORDER BY name, t",
          "extrapolate": false
        }
