    {
      "id": 3,
      "type": "table",
      "title": "Most in-demand campgrounds",
      "description": "Campgrounds ranked by booked %, aggregated across their sites (\u2265100 bookable site-nights).",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 11
      },
      "datasource": {
        "type": "influxdb",
        "uid": "campsites"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "campsites"
          },
          "query": "from(bucket: \"campsites\")\n  |> range(start: -1d, stop: 200d)\n  |> filter(fn: (r) => r._measurement == \"campground_demand\" and (r._field == \"available\" or r._field == \"reserved\"))\n  |> filter(fn: (r) => r.agency =~ /^(${agency:regex})$/)\n  |> filter(fn: (r) => r.name =~ /^(${campsite:regex})$/)\n  |> group(columns: [\"name\", \"agency\", \"_field\"])\n  |> sum()\n  |> pivot(rowKey: [\"name\", \"agency\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => r.available + r.reserved >= 100)\n  |> map(fn: (r) => ({ r with booked_pct: float(v: r.reserved) / float(v: r.available + r.reserved) * 100.0 }))\n  |> group()\n  |> sort(columns: [\"booked_pct\"], desc: true)\n  |> limit(n: 25)\n  |> keep(columns: [\"name\", \"agency\", \"reserved\", \"available\", \"booked_pct\"])"
        }
      ],
