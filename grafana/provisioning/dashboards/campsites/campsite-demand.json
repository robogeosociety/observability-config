      "options": {
        "mode": "markdown",
        "content": "**Campsite Demand** \u2014 where sites are filling up, from the per-site `site_availability` data (collected window \u2248 next 6 months). Filter by Agency / Site (campground)."
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Most in-demand sites \u2014 fewest nights left",
      "description": "Individual sites ranked by nights booked over the collected window (~6mo), among sites with \u226514 bookable nights. 'Nights left' is how many are still available. Filter with Agency / Site (campground).",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 11
      },
      "datasource": {
        "type": "influxdb",
        "uid": "campsites"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "campsites"
          },
          "query": "from(bucket: \"campsites\")\n  |> range(start: -14d)\n  |> filter(fn: (r) => r._measurement == \"site_demand\" and (r._field == \"available_nights\" or r._field == \"reserved_nights\"))\n  |> filter(fn: (r) => r.agency =~ /^(${agency:regex})$/)\n  |> filter(fn: (r) => r.name =~ /^(${campsite:regex})$/)\n  |> group(columns: [\"name\", \"loop\", \"site\", \"_field\"])\n  |> last()\n  |> pivot(rowKey: [\"name\", \"loop\", \"site\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => r.available_nights + r.reserved_nights >= 14)\n  |> map(fn: (r) => ({ r with booked_pct: float(v: r.reserved_nights) / float(v: r.available_nights + r.reserved_nights) * 100.0 }))\n  |> group()\n  |> sort(columns: [\"reserved_nights\"], desc: true)\n  |> limit(n: 40)\n  |> keep(columns: [\"name\", \"loop\", \"site\", \"reserved_nights\", \"available_nights\", \"booked_pct\"])"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "name": 0,
              "loop": 1,
              "site": 2,
              "available_nights": 3,
              "reserved_nights": 4,
              "booked_pct": 5
            },
