        "w": 24,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "**Campsite Demand** — where campgrounds are filling up, from Cloudflare Analytics Engine (`campsite_demand`, per-campground per-night, soonest ~240 nights). Filter by Agency / Site (campground). For per-individual-site demand (survival / soonest-to-run-out), use the **[webapp](https://campsites.robogeosociety.xyz)**."
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Most in-demand campgrounds",
      "description": "Campgrounds ranked by booked %, aggregated across their sites (≥100 bookable site-nights).",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 11
      },
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
        "uid": "campsites_ae"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "campsites_ae"
          },
          "format": "table",
          "meta": {
            "timezone": "UTC"
          },
          "query": "SELECT name, agency, SUM(av) AS available, SUM(rs) AS reserved, IF(SUM(av) + SUM(rs) > 0, SUM(rs) / (SUM(av) + SUM(rs)) * 100, 0.0) AS booked_pct FROM (SELECT index1, blob1 AS night, argMax(double1, timestamp) AS av, argMax(double2, timestamp) AS rs, argMax(blob2, timestamp) AS agency, argMax(blob3, timestamp) AS name FROM campsite_demand WHERE timestamp > now() - INTERVAL '48' HOUR GROUP BY index1, night) WHERE agency IN (${agency:singlequote}) AND name IN (${campsite:singlequote}) GROUP BY index1, name, agency HAVING SUM(av) + SUM(rs) >= 100 ORDER BY booked_pct DESC LIMIT 25",
          "extrapolate": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "name": 0,
              "agency": 1,
              "available": 2,
              "reserved": 3,
              "booked_pct": 4
            },
            "renameByName": {
              "name": "Campground",
              "agency": "Agency",
              "available": "Nights left",
              "reserved": "Booked",
              "booked_pct": "Booked %"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Booked %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient"
                }
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 60
                    },
                    {
                      "color": "red",
                      "value": 85
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
