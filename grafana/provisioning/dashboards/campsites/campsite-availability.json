      "datasource": {
        "type": "influxdb",
        "uid": "campsites"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "campsites"
          },
          "query": "from(bucket: \"campsites\")\n  |> range(start: ${target_date}T00:00:00Z, stop: ${target_date}T23:59:59Z)\n  |> filter(fn: (r) => r._measurement == \"site_availability\")\n  |> filter(fn: (r) => contains(value: r.name, set: ${campsite:json}))\n  |> filter(fn: (r) => r.loop =~ /^${loop:regex}$/ and r.site =~ /^${site:regex}$/)\n  |> last()\n  |> pivot(rowKey: [\"name\", \"loop\", \"site\", \"type\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> map(fn: (r) => ({ r with status: if r.available == 1 then \"available\" else if r.reserved == 1 then \"reserved\" else \"other\" }))\n  |> keep(columns: [\"name\", \"loop\", \"site\", \"type\", \"status\"])\n  |> sort(columns: [\"name\", \"loop\", \"site\"])"
        }
      ],
