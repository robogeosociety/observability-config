            "type": "vertamedia-clickhouse-datasource",
            "uid": "campsites_ae"
          },
          "format": "table",
          "meta": {
            "timezone": "UTC"
          },
          "query": "SELECT IF(SUM(total) > 0, SUM(reserved) / SUM(total) * 100, 0.0) AS pct_reserved FROM (SELECT index1, argMax(double2, timestamp) AS reserved, argMax(double3, timestamp) AS total, argMax(blob2, timestamp) AS agency, argMax(blob3, timestamp) AS name FROM campsite_availability WHERE timestamp > now() - INTERVAL '48' HOUR GROUP BY index1) WHERE agency IN (${agency:singlequote}) AND name IN (${campsite:singlequote})",
          "extrapolate": false
        }
      ],
      "fieldConfig": {
        "defaults": {
