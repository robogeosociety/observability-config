      "type": "table",
      "title": "Sites \u2014 availability for ${target_date}",
      "description": "Per-site status for the selected campground/loop/site on the chosen target night. Drill with the Site (campground) / Loop / Site dropdowns; the night is the Target date dropdown.",
      "gridPos": {
        "x": 0,
        "y": 53,
        "w": 16,
