        "definition": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"campsites\", tag: \"name\", predicate: (r) => contains(value: r.agency, set: ${agency:json}), start: -90d)"
      },
      {
        "name": "loop",
        "label": "Loop",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "campsites"
        },
        "definition": "from(bucket: \"campsites\")\n  |> range(start: -1d, stop: 2035-01-01T00:00:00Z)\n  |> filter(fn: (r) => r._measurement == \"site_availability\" and r._field == \"available\")\n  |> filter(fn: (r) => contains(value: r.name, set: ${campsite:json}))\n  |> keep(columns: [\"loop\"])\n  |> group()\n  |> distinct(column: \"loop\")\n  |> sort()",
        "query": "from(bucket: \"campsites\")\n  |> range(start: -1d, stop: 2035-01-01T00:00:00Z)\n  |> filter(fn: (r) => r._measurement == \"site_availability\" and r._field == \"available\")\n  |> filter(fn: (r) => contains(value: r.name, set: ${campsite:json}))\n  |> keep(columns: [\"loop\"])\n  |> group()\n  |> distinct(column: \"loop\")\n  |> sort()",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "hide": 0,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
