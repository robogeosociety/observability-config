      {
        "name": "site",
        "label": "Site (number)",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "campsites"
        },
        "definition": "from(bucket: \"campsites\")\n  |> range(start: -1d, stop: 2035-01-01T00:00:00Z)\n  |> filter(fn: (r) => r._measurement == \"site_availability\" and r._field == \"available\")\n  |> filter(fn: (r) => contains(value: r.name, set: ${campsite:json}))\n  |> filter(fn: (r) => r.loop =~ /^${loop:regex}$/)\n  |> keep(columns: [\"site\"])\n  |> group()\n  |> distinct(column: \"site\")\n  |> sort()",
        "query": "from(bucket: \"campsites\")\n  |> range(start: -1d, stop: 2035-01-01T00:00:00Z)\n  |> filter(fn: (r) => r._measurement == \"site_availability\" and r._field == \"available\")\n  |> filter(fn: (r) => contains(value: r.name, set: ${campsite:json}))\n  |> filter(fn: (r) => r.loop =~ /^${loop:regex}$/)\n  |> keep(columns: [\"site\"])\n  |> group()\n  |> distinct(column: \"site\")\n  |> sort()",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
