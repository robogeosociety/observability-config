          },
          "query": "SELECT blob1 AS target_date, argMax(blob3, timestamp) AS campsite, argMax(double1, timestamp) AS available, argMax(double3, timestamp) AS total, max(timestamp) AS last_seen FROM campsite_watch WHERE timestamp > now() - INTERVAL '14' DAY GROUP BY blob1, index1 ORDER BY target_date",
