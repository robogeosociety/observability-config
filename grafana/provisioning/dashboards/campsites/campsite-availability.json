    {
      "id": 3,
      "type": "stat",
      "title": "Site-nights available \u2014 all nights",
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
        "uid": "campsites_ae"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "campsites_ae"
          },
          "format": "table",
          "meta": {
            "timezone": "UTC"
          },
          "query": "SELECT SUM(available) AS site_nights_available FROM (SELECT index1, argMax(double1, timestamp) AS available, argMax(blob2, timestamp) AS agency, argMax(blob3, timestamp) AS name FROM campsite_availability WHERE timestamp > now() - INTERVAL '48' HOUR GROUP BY index1) WHERE agency IN (${agency:singlequote}) AND name IN (${campsite:singlequote})",
          "extrapolate": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "% reserved \u2014 all nights",
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
        "uid": "campsites_ae"
      },
      "gridPos": {
        "x": 6,
        "y": 6,
        "w": 6,
        "h": 6
