      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "transit_tracker"
          },
          "query": "from(bucket: \"transit_tracker\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"trip_prediction\" and r._field == \"arrival_time_s\")\n  |> group(columns: [\"stop_id\", \"route_name\", \"is_realtime\"])\n  |> count()\n  |> group()\n  |> pivot(rowKey: [\"stop_id\", \"route_name\"], columnKey: [\"is_realtime\"], valueColumn: \"_value\")\n  |> map(fn: (r) => ({ r with live: if exists r.true then r.true else 0, scheduled: if exists r.false then r.false else 0 }))\n  |> map(fn: (r) => ({ r with coverage_pct: if (r.live + r.scheduled) > 0 then float(v: r.live) / float(v: r.live + r.scheduled) * 100.0 else 0.0 }))\n  |> keep(columns: [\"stop_id\", \"route_name\", \"live\", \"scheduled\", \"coverage_pct\"])\n  |> sort(columns: [\"coverage_pct\"])"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "stop_id": 0,
              "route_name": 1,
              "live": 2,
              "scheduled": 3,
              "coverage_pct": 4
            },
