    {
      "id": 9,
      "type": "table",
      "title": "Recent proxied trips (last schedule pushes)",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "influxdb",
        "uid": "transit_tracker"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "transit_tracker"
          },
          "query": "from(bucket: \"transit_tracker\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"trip_prediction\")\n  |> pivot(\n       rowKey: [\"_time\", \"route_id\", \"route_name\", \"stop_id\", \"headsign\", \"is_realtime\"],\n       columnKey: [\"_field\"],\n       valueColumn: \"_value\"\n     )\n  |> map(fn: (r) => ({ r with arrival_time_ms: int(v: r.arrival_time_s) * 1000 }))\n  |> keep(columns: [\"_time\", \"route_name\", \"stop_id\", \"headsign\", \"is_realtime\", \"arrival_time_ms\"])\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 100)"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "_time": 0,
              "route_name": 1,
              "headsign": 2,
              "arrival_time_ms": 3,
              "is_realtime": 4,
              "stop_id": 5
            },
            "renameByName": {
              "_time": "Broadcast time",
              "route_name": "Route",
              "headsign": "Headsign",
              "arrival_time_ms": "ETA",
              "is_realtime": "RT?",
              "stop_id": "Stop"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ETA"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RT?"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "true": {
                        "text": "live",
                        "color": "green",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "false": {
                        "text": "scheduled",
                        "color": "blue",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Broadcast time",
            "desc": true
          }
        ],
        "cellHeight": "sm"
      }
