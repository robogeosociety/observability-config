  "panels": [
    {
      "id": 1,
      "type": "nodeGraph",
      "title": "Network topology \u2014 OBA \u2192 Proxy \u2192 Displays",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "influxdb",
        "uid": "transit_tracker"
      },
      "description": "Static pipeline topology with live node/edge labels pulled from the latest InfluxDB points. Replaces the retired /monitor SVG topology.",
      "targets": [
        {
          "refId": "nodes",
          "datasource": {
            "type": "influxdb",
            "uid": "transit_tracker"
          },
          "query": "import \"array\"\napiCalls = from(bucket: \"transit_tracker\")\n  |> range(start: -10m)\n  |> filter(fn: (r) => r._measurement == \"service_counter\" and r.name == \"api_calls_total\" and r._field == \"value\")\n  |> last()\n  |> findColumn(fn: (key) => true, column: \"_value\")\nclients = from(bucket: \"transit_tracker\")\n  |> range(start: -10m)\n  |> filter(fn: (r) => r._measurement == \"service_gauge\" and r.name == \"active_clients\" and r._field == \"value\")\n  |> last()\n  |> findColumn(fn: (key) => true, column: \"_value\")\nthrottle = from(bucket: \"transit_tracker\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"service_gauge\" and r.name == \"throttle_rate\" and r._field == \"value\")\n  |> last()\n  |> findColumn(fn: (key) => true, column: \"_value\")\nrefresh = from(bucket: \"transit_tracker\")\n  |> range(start: -10m)\n  |> filter(fn: (r) => r._measurement == \"service_gauge\" and r.name == \"refresh_interval\" and r._field == \"value\")\n  |> last()\n  |> findColumn(fn: (key) => true, column: \"_value\")\napiCallsV = if length(arr: apiCalls) > 0 then apiCalls[0] else 0.0\nclientsV = if length(arr: clients) > 0 then clients[0] else 0.0\nthrottleV = if length(arr: throttle) > 0 then throttle[0] else 0.0\nrefreshV = if length(arr: refresh) > 0 then refresh[0] else 30.0\narray.from(rows: [\n  {id: \"oba\", title: \"OneBusAway API\", subTitle: \"upstream provider\", mainStat: \"calls: \" + string(v: int(v: apiCallsV)), secondaryStat: \"throttle: \" + string(v: throttleV) + \"%\"},\n  {id: \"proxy\", title: \"Transit Proxy\", subTitle: \":8000\", mainStat: \"clients: \" + string(v: int(v: clientsV)), secondaryStat: \"refresh: \" + string(v: int(v: refreshV)) + \"s\"},\n  {id: \"displays\", title: \"Displays\", subTitle: \"ESP32 / simulator\", mainStat: \"active: \" + string(v: int(v: clientsV)), secondaryStat: \"\"},\n])"
        },
        {
          "refId": "edges",
          "datasource": {
            "type": "influxdb",
            "uid": "transit_tracker"
          },
          "query": "import \"array\"\nrefresh = from(bucket: \"transit_tracker\")\n  |> range(start: -10m)\n  |> filter(fn: (r) => r._measurement == \"service_gauge\" and r.name == \"refresh_interval\" and r._field == \"value\")\n  |> last()\n  |> findColumn(fn: (key) => true, column: \"_value\")\nrefreshV = if length(arr: refresh) > 0 then refresh[0] else 30.0\narray.from(rows: [\n  {id: \"e1\", source: \"oba\", target: \"proxy\", mainStat: \"poll / \" + string(v: int(v: refreshV)) + \"s\"},\n  {id: \"e2\", source: \"proxy\", target: \"displays\", mainStat: \"schedule push\"},\n])"
        }
      ],
      "options": {}
    },
