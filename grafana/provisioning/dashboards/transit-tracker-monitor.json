    {
      "id": 10,
      "type": "timeseries",
      "title": "Live vs scheduled trips / interval",
      "description": "Broadcast trips split by the is_realtime tag. A growing 'scheduled' band = OBA realtime coverage gaps (sign falls back to GTFS schedule).",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "transit_tracker"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "transit_tracker"
          },
          "query": "from(bucket: \"transit_tracker\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"trip_prediction\" and r._field == \"arrival_time_s\")\n  |> group(columns: [\"is_realtime\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: count, createEmpty: false)\n  |> map(fn: (r) => ({ r with is_realtime: if r.is_realtime == \"true\" then \"live\" else \"scheduled\" }))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
