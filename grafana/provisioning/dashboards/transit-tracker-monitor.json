    {
      "id": 11,
      "type": "stat",
      "title": "Realtime coverage %",
      "description": "live / (live + scheduled) over the window. A persistent dip flags an upstream OBA feed gap.",
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "transit_tracker"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "transit_tracker"
          },
          "query": "from(bucket: \"transit_tracker\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"trip_prediction\" and r._field == \"arrival_time_s\")\n  |> group()\n  |> reduce(\n       identity: {live: 0, total: 0},\n       fn: (r, accumulator) => ({\n         live: accumulator.live + (if r.is_realtime == \"true\" then 1 else 0),\n         total: accumulator.total + 1\n       }))\n  |> map(fn: (r) => ({ _time: now(), _value: if r.total > 0 then float(v: r.live) / float(v: r.total) * 100.0 else 0.0 }))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "green",
                "value": 85
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
