      "type": "table",
      "title": "Closest to sold out for $target_date (latest snapshot)",
      "gridPos": {"x": 14, "y": 11, "w": 10, "h": 9},
      "datasource": {"type": "influxdb", "uid": "campsites"},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "influxdb", "uid": "campsites"},
        "query": "from(bucket: \"campsites\")\n  |> range(start: -90d)\n  |> filter(fn: (r) => r._measurement == \"availability\" and r.target_date == \"${target_date}\")\n  |> filter(fn: (r) => contains(value: r.agency, set: ${agency:json}))\n  |> filter(fn: (r) => r._field == \"available\" or r._field == \"total\")\n  |> last()\n  |> pivot(rowKey: [\"name\", \"agency\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> map(fn: (r) => ({ r with pct_available: if r.total > 0 then float(v: r.available) / float(v: r.total) * 100.0 else 0.0 }))\n  |> group()\n  |> keep(columns: [\"name\", \"agency\", \"available\", \"total\", \"pct_available\"])\n  |> sort(columns: [\"available\"])"
      }],
      "transformations": [],
      "fieldConfig": {
        "defaults": {"custom": {"align": "auto", "filterable": true}},
