      "datasource": {"type": "influxdb", "uid": "campsites"},
      "targets": [{
        "refId": "A",
        "datasource": {"type": "influxdb", "uid": "campsites"},
        "query": "from(bucket: \"campsites\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"availability\" and r._field == \"available\")\n  |> filter(fn: (r) => contains(value: r.agency, set: ${agency:json}))\n  |> group(columns: [\"agency\", \"_time\"])\n  |> sum()\n  |> group(columns: [\"agency\"])\n  |> sort(columns: [\"_time\"])"
      }],
