      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "influxdb", "uid": "campsites"},
          "query": "from(bucket: \"campsites\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"availability\" and r._field == \"available\")\n  |> filter(fn: (r) => r.target_date == \"${target_date}\")\n  |> filter(fn: (r) => contains(value: r.name, set: ${campsite:json}))\n  |> group(columns: [\"name\"])\n  |> aggregateWindow(every: 1d, fn: last, createEmpty: false)"
        },
        {
          "refId": "B",
          "hide": false,
          "datasource": {"type": "influxdb", "uid": "campsites"},
          "query": "from(bucket: \"campsites\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"availability\" and r._field == \"available\")\n  |> filter(fn: (r) => r.target_date == \"${target_date}\")\n  |> filter(fn: (r) => contains(value: r.name, set: ${campsite:json}))\n  |> group(columns: [\"name\"])\n  |> aggregateWindow(every: 1d, fn: last, createEmpty: true)\n  |> holtWinters(n: 30, interval: 1d, withFit: true)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short", "min": 0,
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 5, "showPoints": "auto", "spanNulls": true},
