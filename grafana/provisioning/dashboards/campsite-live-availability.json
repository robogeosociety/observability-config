    {
      "id": 7,
      "type": "timeseries",
      "title": "Hot-date burn-down (available over time, per target date)",
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
        "uid": "campsites_ae"
      },
      "gridPos": {
        "x": 14,
        "y": 12,
        "w": 10,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "campsites_ae"
          },
          "format": "time_series",
          "meta": {
            "timezone": "UTC"
          },
          "query": "SELECT timestamp AS t, blob1 AS target_date, SUM(_sample_interval * double1) / SUM(_sample_interval) AS available FROM campsite_watch WHERE timestamp > now() - INTERVAL '14' DAY GROUP BY t, target_date ORDER BY t",
          "extrapolate": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "always",
            "pointSize": 5,
            "spanNulls": true
          },
          "color": {
