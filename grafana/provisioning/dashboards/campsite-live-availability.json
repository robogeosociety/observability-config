  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "About",
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 6},
      "options": {
        "mode": "markdown",
        "content": "# Live availability — Cloudflare Workers Analytics Engine\n\nCurrent campsite availability for the **campsite-availability collector** (repo `robot-geographical-society`), read from the **AE SQL API** (ClickHouse dialect) via the `campsites_ae` ClickHouse datasource. There are **61** reservable campsites.\n\n- System totals / by-agency / fully-booked / per-campground: latest per-site rows of `campsite_availability` (`argMax(... , timestamp) GROUP BY index1` over a recent window).\n- Hot-date burn-down: `campsite_watch` (`double1` available over time, one series per target_date).\n\nAE is sampled — counts are weighted by `SUM(_sample_interval)`. Panels read *No data* until the `CF_AE_TOKEN` secret (Account → Account Analytics → Read) is set and the nightly run emits. Account `d7adee58513c1b2f770ccaac90cf114f`."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Site-nights available (system)",
      "datasource": {"type": "grafana-clickhouse-datasource", "uid": "campsites_ae"},
      "gridPos": {"x": 0, "y": 6, "w": 6, "h": 6},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "grafana-clickhouse-datasource", "uid": "campsites_ae"},
          "queryType": "sql",
          "rawSql": "SELECT SUM(available) AS site_nights_available FROM (SELECT index1, argMax(double1, timestamp) AS available FROM campsite_availability WHERE timestamp > now() - INTERVAL 48 HOUR GROUP BY index1)",
          "format": 1,
          "meta": {"timezone": "UTC"}
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "green"}, "decimals": 0},
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "textMode": "auto"}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "% reserved (system)",
      "datasource": {"type": "grafana-clickhouse-datasource", "uid": "campsites_ae"},
      "gridPos": {"x": 6, "y": 6, "w": 6, "h": 6},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "grafana-clickhouse-datasource", "uid": "campsites_ae"},
          "queryType": "sql",
          "rawSql": "SELECT IF(SUM(total) > 0, SUM(reserved) / SUM(total) * 100, 0) AS pct_reserved FROM (SELECT index1, argMax(double2, timestamp) AS reserved, argMax(double3, timestamp) AS total FROM campsite_availability WHERE timestamp > now() - INTERVAL 48 HOUR GROUP BY index1)",
          "format": 1,
          "meta": {"timezone": "UTC"}
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "percent", "min": 0, "max": 100, "decimals": 1, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 70}, {"color": "red", "value": 90}]}},
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "textMode": "auto"}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Fully-booked campgrounds (datesOpen=0)",
      "datasource": {"type": "grafana-clickhouse-datasource", "uid": "campsites_ae"},
      "gridPos": {"x": 12, "y": 6, "w": 6, "h": 6},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "grafana-clickhouse-datasource", "uid": "campsites_ae"},
          "queryType": "sql",
          "rawSql": "SELECT COUNT() AS fully_booked FROM (SELECT index1, argMax(double4, timestamp) AS dates_open FROM campsite_availability WHERE timestamp > now() - INTERVAL 48 HOUR GROUP BY index1) WHERE dates_open = 0",
          "format": 1,
          "meta": {"timezone": "UTC"}
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short", "decimals": 0, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 10}]}},
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "textMode": "auto"}
    },
    {
      "id": 5,
      "type": "barchart",
      "title": "Site-nights available by agency",
      "datasource": {"type": "grafana-clickhouse-datasource", "uid": "campsites_ae"},
      "gridPos": {"x": 18, "y": 6, "w": 6, "h": 6},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "grafana-clickhouse-datasource", "uid": "campsites_ae"},
          "queryType": "sql",
          "rawSql": "SELECT agency, SUM(available) AS site_nights_available, SUM(reserved) AS site_nights_reserved FROM (SELECT index1, argMax(blob2, timestamp) AS agency, argMax(double1, timestamp) AS available, argMax(double2, timestamp) AS reserved FROM campsite_availability WHERE timestamp > now() - INTERVAL 48 HOUR GROUP BY index1) GROUP BY agency ORDER BY site_nights_available DESC",
          "format": 1,
          "meta": {"timezone": "UTC"}
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short", "color": {"mode": "palette-classic"}, "custom": {"lineWidth": 1, "fillOpacity": 80}},
        "overrides": []
      },
      "options": {"orientation": "horizontal", "xTickLabelRotation": 0, "showValue": "auto", "stacking": "none", "legend": {"showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 6,
      "type": "table",
      "title": "Per-campground availability (latest)",
      "datasource": {"type": "grafana-clickhouse-datasource", "uid": "campsites_ae"},
      "gridPos": {"x": 0, "y": 12, "w": 14, "h": 11},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "grafana-clickhouse-datasource", "uid": "campsites_ae"},
          "queryType": "sql",
          "rawSql": "SELECT name, agency, available, reserved, total, dates_open, IF(total > 0, reserved / total * 100, 0) AS pct_reserved FROM (SELECT index1, argMax(blob3, timestamp) AS name, argMax(blob2, timestamp) AS agency, argMax(double1, timestamp) AS available, argMax(double2, timestamp) AS reserved, argMax(double3, timestamp) AS total, argMax(double4, timestamp) AS dates_open FROM campsite_availability WHERE timestamp > now() - INTERVAL 48 HOUR GROUP BY index1) ORDER BY available ASC",
          "format": 1,
          "meta": {"timezone": "UTC"}
        }
      ],
      "transformations": [],
      "fieldConfig": {
        "defaults": {"custom": {"align": "auto", "filterable": true}},
        "overrides": [
          {"matcher": {"id": "byName", "options": "name"}, "properties": [{"id": "displayName", "value": "Campsite"}, {"id": "custom.width", "value": 220}]},
          {"matcher": {"id": "byName", "options": "agency"}, "properties": [{"id": "displayName", "value": "Agency"}, {"id": "custom.width", "value": 100}]},
          {"matcher": {"id": "byName", "options": "available"}, "properties": [{"id": "displayName", "value": "Avail"}, {"id": "custom.cellOptions", "value": {"type": "color-background", "mode": "basic"}}, {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 1}, {"color": "green", "value": 5}]}}]},
          {"matcher": {"id": "byName", "options": "reserved"}, "properties": [{"id": "displayName", "value": "Reserved"}]},
          {"matcher": {"id": "byName", "options": "total"}, "properties": [{"id": "displayName", "value": "Total"}]},
          {"matcher": {"id": "byName", "options": "dates_open"}, "properties": [{"id": "displayName", "value": "Dates open"}]},
          {"matcher": {"id": "byName", "options": "pct_reserved"}, "properties": [{"id": "displayName", "value": "% reserved"}, {"id": "unit", "value": "percent"}, {"id": "decimals", "value": 0}]}
        ]
      },
      "options": {"showHeader": true, "sortBy": [{"displayName": "Avail", "desc": false}], "footer": {"show": false}, "cellHeight": "sm"}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Hot-date burn-down (available over time, per target date)",
      "datasource": {"type": "grafana-clickhouse-datasource", "uid": "campsites_ae"},
      "gridPos": {"x": 14, "y": 12, "w": 10, "h": 11},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "grafana-clickhouse-datasource", "uid": "campsites_ae"},
          "queryType": "sql",
          "rawSql": "SELECT timestamp AS t, blob1 AS target_date, SUM(_sample_interval * double1) / SUM(_sample_interval) AS available FROM campsite_watch WHERE timestamp > now() - INTERVAL 14 DAY GROUP BY t, target_date ORDER BY t",
          "format": 1,
          "meta": {"timezone": "UTC"}
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short", "min": 0,
          "custom": {"drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 2, "fillOpacity": 8, "showPoints": "always", "pointSize": 5, "spanNulls": true},
          "color": {"mode": "palette-classic"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        },
        "overrides": []
      },
      "options": {"tooltip": {"mode": "multi", "sort": "asc"}, "legend": {"showLegend": true, "displayMode": "table", "placement": "bottom", "calcs": ["last", "min"]}}
