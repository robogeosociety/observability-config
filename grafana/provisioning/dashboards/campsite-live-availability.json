      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "campsites_ae"
          },
          "format": "table",
          "meta": {
            "timezone": "UTC"
          },
          "query": "SELECT IF(SUM(total) > 0, SUM(reserved) / SUM(total) * 100, 0.0) AS pct_reserved FROM (SELECT index1, argMax(double2, timestamp) AS reserved, argMax(double3, timestamp) AS total FROM campsite_availability WHERE timestamp > now() - INTERVAL '48' HOUR GROUP BY index1)",
          "extrapolate": false
        }
