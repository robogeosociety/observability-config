          },
          "query": "SELECT agency, SUM(available) AS site_nights_available, SUM(reserved) AS site_nights_reserved FROM (SELECT index1, argMax(blob2, timestamp) AS agency, argMax(double1, timestamp) AS available, argMax(double2, timestamp) AS reserved FROM campsite_availability WHERE timestamp > now() - INTERVAL '48' HOUR GROUP BY index1) GROUP BY agency ORDER BY site_nights_available DESC",
