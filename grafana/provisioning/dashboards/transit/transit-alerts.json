{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active alerts now",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "influxdb",
        "uid": "transit_tracker"
      },
      "description": "Distinct alerts currently flagged active in the latest poll cycle.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "transit_tracker"
          },
          "query": "from(bucket: \"transit_tracker\")\n  |> range(start: -15m)\n  |> filter(fn: (r) => r._measurement == \"service_alert\" and r._field == \"active\")\n  |> last()\n  |> filter(fn: (r) => r._value == true)\n  |> group()\n  |> count()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "piechart",
      "title": "Active alert-points by reason",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "influxdb",
        "uid": "transit_tracker"
      },
      "description": "Share of active-alert observations by GTFS-RT reason over the window.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "transit_tracker"
          },
          "query": "from(bucket: \"transit_tracker\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"service_alert\" and r._field == \"active\" and r._value == true)\n  |> group(columns: [\"reason\"])\n  |> count()\n  |> group()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value"
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Alerts seen (window)",
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 10,
        "h": 5
      },
      "datasource": {
        "type": "influxdb",
        "uid": "transit_tracker"
      },
      "description": "Distinct alert_ids observed anywhere in the window (active or cleared).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "transit_tracker"
          },
          "query": "from(bucket: \"transit_tracker\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"service_alert\" and r._field == \"active\")\n  |> keep(columns: [\"alert_id\"])\n  |> group()\n  |> distinct(column: \"alert_id\")\n  |> count()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Active alerts over time (by reason)",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "transit_tracker"
      },
      "description": "Count of active-alert observations per reason. A rising band = an ongoing disruption (and a likely cause of a realtime-coverage dip).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "transit_tracker"
          },
          "query": "from(bucket: \"transit_tracker\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"service_alert\" and r._field == \"active\" and r._value == true)\n  |> group(columns: [\"reason\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: count, createEmpty: false)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum",
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 5,
      "type": "state-timeline",
      "title": "Alert activity timeline",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "transit_tracker"
      },
      "description": "Per-alert active/inactive lanes (grouped by reason + alert_id), straight off the service_alert `active` field.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "transit_tracker"
          },
          "query": "from(bucket: \"transit_tracker\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"service_alert\" and r._field == \"active\")\n  |> group(columns: [\"reason\", \"alert_id\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n  |> map(fn: (r) => ({ r with _value: if r._value then 1 else 0 }))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "clear",
                  "index": 0
                },
                "1": {
                  "text": "active",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "rowHeight": 0.9,
        "mergeValues": true,
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Alerts in window (latest summary)",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "influxdb",
        "uid": "transit_tracker"
      },
      "description": "Latest summary + affected routes/stops per alert seen in the window. summary/affects are both string fields (no pivot type-conflict).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "transit_tracker"
          },
          "query": "from(bucket: \"transit_tracker\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"service_alert\" and (r._field == \"summary\" or r._field == \"affects\"))\n  |> last()\n  |> pivot(rowKey: [\"alert_id\", \"reason\", \"severity\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> keep(columns: [\"reason\", \"severity\", \"summary\", \"affects\"])\n  |> sort(columns: [\"severity\"])"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "reason": 0,
              "severity": 1,
              "affects": 2,
              "summary": 3
            },
            "renameByName": {
              "reason": "Reason",
              "severity": "Severity",
              "affects": "Affects",
              "summary": "Summary"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "summary"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 700
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "transit_tracker",
    "transit",
    "alerts"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
