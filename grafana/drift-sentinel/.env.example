# drift-sentinel config — copy to .env (gitignored). Host job: localhost InfluxDB.
INFLUX_URL=http://localhost:8086
INFLUX_ORG=home
# Read-only InfluxDB token (reuse the ask-dash read-only token, or mint one).
INFLUX_READ_TOKEN=
# Same Discord channel webhook the Grafana alerts use (from grafana/.env).
DISCORD_WEBHOOK_URL=
# Tuning.
REALERT_AFTER_S=21600     # don't repeat the same uid+state alert within 6h
DEGRADED_RATIO=0.4        # recent write-rate below 40% of trailing-24h baseline = degraded
