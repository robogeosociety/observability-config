# cicd-collector config — cp to .env (gitignored, chmod 600) and fill in.
# deploy.sh copies the whole .env to the internal-disk runtime dir.

# GitHub org whose repos are auto-discovered every poll (non-archived only).
GH_ORG=robogeosociety

# Fine-grained PAT: Metadata read + Actions read on all org repos (read-only —
# the collector never writes to GitHub). Classic `repo` scope also works.
GH_TOKEN=

# Optional comma-separated owner/name repos outside the org (still user-owned).
#GH_EXTRA_REPOS=tommybd/some-repo

# InfluxDB write target — a token scoped to write on the `cicd` bucket.
INFLUX_URL=http://localhost:8086
INFLUX_ORG=home
INFLUX_BUCKET=cicd
INFLUX_TOKEN=

# First-run backfill horizon (days) and poll-window overlap (minutes; rewrites
# are idempotent so overlap is safe).
#BACKFILL_DAYS=30
#OVERLAP_MIN=30
