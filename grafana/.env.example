# Grafana container secrets — copy to .env and fill in. Never commit .env.
# Used by docker-compose.yml.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# InfluxDB token Grafana uses to query (datasource provisioning).
INFLUX_GRAFANA_TOKEN=
# User login is Tailscale identity via `tailscale serve` (Grafana auth proxy) —
# no OAuth client/secret needed. The admin login form (above) is the break-glass.
# Cloudflare API token for the Workers Analytics Engine SQL API (collector-history
# dashboard, ClickHouse datasource). Scope: Account -> Account Analytics -> Read.
CF_ANALYTICS_TOKEN=
# Cloudflare API token for the campsites AE dashboards (campsites_ae ClickHouse
# datasource). Same scope: Account -> Account Analytics -> Read (read-only).
CF_ANALYTICS_TOKEN=
# Discord channel webhook for the stack-availability alert (provisioning/alerting/).
# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> pick a
# channel -> Copy Webhook URL. This URL is the secret (anyone with it can post).
#   DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
DISCORD_WEBHOOK_URL=
