# Grafana container secrets — copy to .env and fill in. Never commit .env.
# Used by docker-compose.yml.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# InfluxDB token Grafana uses to query (datasource provisioning).
INFLUX_GRAFANA_TOKEN=
# Google OAuth (passkey login). From the Google Cloud console OAuth client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
