# InfluxDB container secrets — copy to .env and fill in. Never commit .env.
# Used by docker-compose.yml.
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=
INFLUX_ORG=home
INFLUX_BUCKET=tempest_archive
# Admin token (full access) — minted at first run.
INFLUX_ADMIN_TOKEN=
# Per-source write tokens.
INFLUX_HA_TOKEN=
INFLUX_TEMPEST_TOKEN=
# Shared write-only token for collector heartbeats → `ops` bucket (see COLLECTORS.md).
# backup.sh prefers this over the admin token for its heartbeat emit.
INFLUX_OPS_TOKEN=

# Optional: Cloudflare R2 offsite backup (backup.sh uploads here when both are set).
# r2_upload.py shells out to `wrangler r2 object put`, so auth is a single API
# token — no S3 access-key pair. Create a Cloudflare API token with the
# "Workers R2 Storage:Edit" permission (My Profile → API Tokens), scoped to the
# account that owns the `influxdb-backups` bucket.
CLOUDFLARE_API_TOKEN=
R2_BUCKET=influxdb-backups
# Only needed for the `r2_upload.py list` debug command (object listing uses the
# REST API); put/check work with the token alone.
CLOUDFLARE_ACCOUNT_ID=
