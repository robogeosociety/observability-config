# influx bucket-stats collector secrets — copy to bucket-stats/.env
# (gitignored, chmod 600).

INFLUX_URL=http://localhost:8086
INFLUX_ORG=home
INFLUX_OPS_BUCKET=ops

# Token needs READ on every bucket (to count points per bucket) + WRITE on `ops`
# (to store the stats). The admin token satisfies both; a narrower token must be
# read-all + write-ops. /metrics itself needs no auth.
INFLUX_TOKEN=

# Throughput window in seconds — keep equal to the LaunchAgent StartInterval
# (300) so points_per_sec is a clean per-second rate.
BUCKET_STATS_INTERVAL_S=300
