# campsites ingest secrets — copy to campsites/.env (gitignored, chmod 600).

# InfluxDB (write to the `campsites` bucket)
INFLUX_URL=http://localhost:8086
INFLUX_ORG=home
INFLUX_CAMPSITES_BUCKET=campsites
# Write-only token scoped to `campsites` (influx auth create --write-bucket ...).
INFLUX_CAMPSITES_TOKEN=
# Shared write-only token for collector heartbeats → `ops` bucket (see COLLECTORS.md).
INFLUX_OPS_TOKEN=

# R2: no token needed — the ingest reads R2 (list+get) through the existing
# `wrangler login` OAuth session via the Cloudflare API. Just be logged in
# (`wrangler whoami`). Only the bucket name lives here (account id defaults in code):
R2_CAMPSITE_BUCKET=campsite-raw
