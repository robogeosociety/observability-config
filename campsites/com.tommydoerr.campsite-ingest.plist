<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tommydoerr.campsite-ingest</string>
    <!-- Runs the INTERNAL-disk copy (deploy.sh installs it): launchd-spawned
         python can't read /Volumes (TCC blocks the script-file open and hangs),
         so the script + .env live on the internal disk. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/tommydoerr/.local/share/campsite-ingest/ingest.sh</string>
    </array>
    <!-- 07:30 local — ~90 min after the collector Worker cron (13:00 UTC / 06:00 PDT). -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>7</integer>
        <key>Minute</key><integer>30</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/tommydoerr/Library/Logs/campsite-ingest.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/tommydoerr/Library/Logs/campsite-ingest.log</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
