# Copy to `.env` (gitignored) and fill in. The PAT is used only to mint short-lived
# registration tokens at container start — it is never written into the runner config.
GH_OWNER=tommyroar
GH_REPO=tommybot                 # repo-scoped runner (tommyroar is a user, not an org)
# GH_SCOPE=org                   # uncomment (and drop GH_REPO) only if tommyroar becomes an org
RUNNER_PAT=github_pat_xxxxx      # fine-grained PAT · Administration: read+write on the target repo(s)
RUNNER_LABELS=self-hosted,linux,arm64,orbstack,mini
# RUNNER_WORK_DIR=~/.local/share/github-runner/_work
