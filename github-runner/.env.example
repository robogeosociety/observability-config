# Copy to `.env` (gitignored) and fill in. The PAT is used only to mint short-lived
# registration tokens at container start — it is never written into the runner config.
#
# TARGET (once tommyroar is an org): org-scoped — ONE runner serves every repo in the org.
# GH_OWNER=tommyroar-org
# GH_SCOPE=org                   # org-scoped: drop GH_REPO; PAT needs org manage_runners
#
# CURRENT (user account): repo-scoped — one repo per runner.
GH_OWNER=tommyroar
GH_REPO=tommybot                 # repo-scoped runner (tommyroar is a user, not an org)
RUNNER_PAT=github_pat_xxxxx      # fine-grained PAT · Administration: read+write on the target (org or repo)
RUNNER_LABELS=self-hosted,linux,arm64,orbstack,mini
# RUNNER_WORK_DIR=~/.local/share/github-runner/_work
